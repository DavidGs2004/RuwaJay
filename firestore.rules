rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProperty() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if ownsProperty() || isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if (signedIn() && request.auth.uid == userId) || isAdmin();

      match /favorites/{propertyId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }


    match /conversations/{conversationId} {
      // Check if user is a participant for READ and UPDATE
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn(); // Participants array should be set on create

      match /messages/{messageId} {
        // Message access depends on the parent conversation participants
        allow read, create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /system_updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}

