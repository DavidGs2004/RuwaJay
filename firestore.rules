rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProperty() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if ownsProperty();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;

      match /favorites/{propertyId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /conversations/{conversationId} {
      // Check if user is a participant for READ and UPDATE
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn(); // Participants array should be set on create

      match /messages/{messageId} {
        // Message access depends on the parent conversation participants
        allow read, create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
