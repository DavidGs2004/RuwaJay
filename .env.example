# RuwaJay Environment Variables
# Copy this file to .env and fill in your values

# Backend
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Authentication database (SQLite by default)
DATABASE_PATH=backend/app/ruwajay.db
CORS_ORIGINS=http://localhost:5173

# Email used for password recovery (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=tu-clave-de-aplicacion
SMTP_FROM=tu-correo@gmail.com

# Supabase (optional - uses local demo data by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mapbox (optional - uses OpenStreetMap tiles by default)
MAPBOX_ACCESS_TOKEN=

# Frontend API URL
VITE_API_URL=http://localhost:8000
