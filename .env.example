# Mapbox public browser token (starts with pk.)
# Enables traffic-aware routing, incidents and road closures.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token

# Supabase Storage (public anon key; never use the service_role key in clients)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_SUPABASE_PROPERTY_BUCKET=property-images

# Copy the same public values to android-app/local.properties:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_public_anon_key
# SUPABASE_PROPERTY_BUCKET=property-images
