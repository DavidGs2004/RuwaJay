rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('suspended', false) == false
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended'));
    }
    function chatMember(roomId) {
      return signedIn() && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(roomId)).data.participants;
    }
    match /chat/{roomId}/{userId}/{fileName} {
      allow read: if chatMember(roomId);
      allow create: if chatMember(roomId) && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|audio/.*|video/webm)');
      allow delete: if chatMember(roomId) && request.auth.uid == userId;
    }
    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /verification/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId
        || request.auth.token.get('role','') == 'admin'
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role','') == 'admin');
      allow create: if signedIn() && request.auth.uid == userId && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /properties/{propertyId}/{userId}/{fileName} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
