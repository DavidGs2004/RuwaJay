# Copiar a .env.local. Solo URLs y claves públicas: ningún secreto del servidor.
# Confirmar el proyecto con el compañero; no publicar con placeholders.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Alternativa explícita (si se omite, se deriva de VITE_SUPABASE_URL):
# VITE_RUWA_BACKEND_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ruwajay-api

# Android: copiar la MISMA URL pública a android-app/local.properties:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# RUWA_BACKEND_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ruwajay-api
# No hace falta anon key para este gateway: usa el token Firebase del usuario.
# Nunca incluir service_role, cuenta de servicio Google ni secreto Cron.

# Opcionales; mapas básicos funcionan sin Mapbox y sin tráfico en vivo.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_FIREBASE_VAPID_KEY=
