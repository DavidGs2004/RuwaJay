rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAccountActive(userData) {
      return userData.get('accountStatus', '') in ['active','inactive','suspended']
        ? userData.accountStatus == 'active'
        : (userData.get('suspended', false) == false
            && !(userData.get('status', 'active') in ['suspended','inactive']));
    }
    function signedIn() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || isAccountActive(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
      );
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'admin'
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }
    function member(data) {
      return signedIn() && request.auth.uid in data.get('participants', []);
    }
    function ownsProperty() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function validProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (data.get('phone',null) == null || (data.phone is string && data.phone.size() <= 40))
        && data.get('bio','') is string && data.get('bio','').size() <= 2000;
    }
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id','name','email','phone','role','avatar','avatarImage','photoURL','createdAt','accountStatus','status'])
        && (request.resource.data.role in ['seeker','owner'] || request.auth.token.get('role','') == 'admin')
        && request.resource.data.get('accountStatus','active') == 'active'
        && request.resource.data.get('status','active') == 'active'
        && validProfile(request.resource.data);
      allow update: if isAdmin() || (validProfile(request.resource.data) && signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','bio','avatarId','avatarImage','avatar','photoURL','role','verificationStatus','verificationRequestedAt','verificationRejectionReason','dpiData'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus'])
          || request.resource.data.get('verificationStatus',null) in ['pendiente',null])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationRejectionReason'])
          || request.resource.data.get('verificationRejectionReason',null) == null)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dpiData'])
          || resource.data.get('verificationStatus','') != 'aprobada'
          || request.resource.data.get('verificationStatus',null) in ['pendiente',null]
          || (resource.data.dpiData is map && request.resource.data.dpiData is map
            && request.resource.data.dpiData.diff(resource.data.dpiData).affectedKeys().hasOnly(['department','municipality','legalAddress','emergencyName','emergencyPhone','emergencyRelation','updatedAt'])))
        && (request.resource.data.get('role','seeker') == resource.data.get('role','seeker')
          || (resource.data.get('role','seeker') in ['seeker','owner'] && request.resource.data.role in ['seeker','owner'])));
      allow delete: if isAdmin();
      match /favorites/{propertyId} { allow read, write: if signedIn() && request.auth.uid == userId; }
      match /saved_searches/{searchId} { allow read, write: if signedIn() && request.auth.uid == userId; }
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['web','android'];
      }
      match /notifications/{notificationId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin();
        allow update: if signedIn() && (request.auth.uid == userId || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
    }
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified',false) == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verificationStatus','') == 'aprobada'
        && request.resource.data.get('verified',false) == false
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 1000000000
        && request.resource.data.images is list && request.resource.data.images.size() > 0 && request.resource.data.images.size() <= 8);
      allow update: if isAdmin() || (ownsProperty()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('verified',false) == resource.data.get('verified',false)
        && request.resource.data.images is list && request.resource.data.images.size() > 0 && request.resource.data.images.size() <= 8
        && request.resource.data.price > 0 && request.resource.data.price <= 1000000000
        && request.resource.data.title is string && request.resource.data.title.size() <= 200);
      allow delete: if ownsProperty() || isAdmin();
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 4000
          && request.resource.data.get('verifiedTenant',false) == false;
        allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment','rating','tags'])
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5);
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.get('participants', []) ||
        member(resource.data) ||
        isAdmin()
      );
      allow create: if false;
      allow update: if member(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt','unreadCount','clearedAt','lastMessage','lastMessageTimestamp','lastSenderId','lastSenderName','lastMessageId','activeCall'])
        && request.resource.data.get('readAt',{}).diff(resource.data.get('readAt',{})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('clearedAt',{}).diff(resource.data.get('clearedAt',{})).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt','unreadCount','clearedAt','activeCall'])
          ? request.resource.data.get('unreadCount',{}).diff(resource.data.get('unreadCount',{})).affectedKeys().hasOnly([request.auth.uid])
          : (request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessageId != resource.data.get('lastMessageId','')
            && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
            && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)).data.createdAt == request.time));
      allow delete: if isAdmin();
      match /messages/{messageId} {
        function roomMember() { return member(get(/databases/$(database)/documents/conversations/$(conversationId)).data); }
        allow read: if roomMember();
        allow create: if roomMember() && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text','image','audio','video','location']
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update: if roomMember() && (
          (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','isEdited','editedAt','isDeleted','mediaUrl','image','deletedAt']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.get('reactions',{}).diff(resource.data.get('reactions',{})).affectedKeys().hasOnly([request.auth.uid])));
        allow delete: if roomMember() && resource.data.senderId == request.auth.uid;
      }
    }
    match /visits/{visitId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.tenantId == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.tenantId == request.auth.uid || isAdmin());
      allow create, update: if false; // Atomic slot reservations and state transitions run on the server.
    }
    match /visit_slots/{slotId} { allow read, write: if false; }
    match /lease_drafts/{leaseId} {
      allow read: if member(get(/databases/$(database)/documents/conversations/$(leaseId)).data);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['participants','conversationId','propertyId','ownerId','terms','updatedAt'])
        && request.resource.data.conversationId == leaseId
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/conversations/$(leaseId)).data.ownerId == request.auth.uid
        && request.resource.data.participants == get(/databases/$(database)/documents/conversations/$(leaseId)).data.participants
        && request.resource.data.propertyId == get(/databases/$(database)/documents/conversations/$(leaseId)).data.propertyId
        && request.resource.data.terms is map
        && request.resource.data.terms.monthlyRent is number && request.resource.data.terms.monthlyRent > 0
        && request.resource.data.terms.depositAmount is number && request.resource.data.terms.depositAmount >= 0
        && request.resource.data.terms.durationMonths is number && request.resource.data.terms.durationMonths >= 1 && request.resource.data.terms.durationMonths <= 120;
    }
    match /verification_requests/{userId} {
      allow read, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.userId == userId && request.resource.data.status == 'pendiente';
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.userId == userId && request.resource.data.status == 'pendiente')
      );
    }
    match /system_updates/{updateId} { allow read: if true; allow write: if isAdmin(); }
    // Authenticated WebRTC call signaling
    match /active_calls/{callId} {
      function callMember(data) {
        return signedIn() && (request.auth.uid == data.get('callerId','') || request.auth.uid == data.get('receiverId','')
          || request.auth.uid in data.get('receiverIds',[]) || request.auth.uid in data.get('participants',[])
          || request.auth.token.get('email','') in data.get('receiverEmails',[]));
      }
      allow read: if callMember(resource.data);
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid
        && request.resource.data.get('receiverId','') != request.auth.uid
        && request.resource.data.get('roomId','') != ''
        && member(get(/databases/$(database)/documents/conversations/$(request.resource.data.roomId)).data)
        && request.resource.data.get('receiverId','') in get(/databases/$(database)/documents/conversations/$(request.resource.data.roomId)).data.participants;
      allow update: if callMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','offer','answer','callerCandidates','receiverCandidates','callerMuted','receiverMuted','connectedAt','endedAt','updatedAt']);
      allow delete: if callMember(resource.data);
    }
  }
}
