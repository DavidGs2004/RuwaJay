rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAccountActive(data) {
      return data.get('accountStatus','') in ['active','inactive','suspended']
        ? data.accountStatus == 'active'
        : (data.get('suspended',false) == false && !(data.get('status','active') in ['inactive','suspended']));
    }
    function signedIn() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || isAccountActive(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data));
    }
    function chatMember(roomId) {
      let data = firestore.get(/databases/(default)/documents/conversations/$(roomId)).data;
      return signedIn() && (request.auth.uid in data.get('participants', [])
        || data.get('seekerId','') == request.auth.uid || data.get('tenantId','') == request.auth.uid || data.get('ownerId','') == request.auth.uid);
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'admin'
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }
    match /chat/{roomId}/{userId}/{fileName} {
      allow read: if chatMember(roomId) || isAdmin();
      allow create: if ((chatMember(roomId) && request.auth.uid == userId) || isAdmin())
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp|gif|avif|heic|heif)|audio/.*|video/(webm|mp4|quicktime|3gpp|x-matroska|ogg))');
      allow delete: if (chatMember(roomId) && request.auth.uid == userId) || isAdmin();
    }
    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if ((signedIn() && request.auth.uid == userId) || isAdmin()) && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }
    match /verification/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if ((signedIn() && request.auth.uid == userId) || isAdmin()) && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }
    match /properties/{propertyId}/{userId}/{fileName} {
      allow read: if true;
      allow create: if ((signedIn() && request.auth.uid == userId) || isAdmin())
        && request.resource.size < 12 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }
  }
}
